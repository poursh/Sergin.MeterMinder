<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <IsPackable>false</IsPackable>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="coverlet.collector" />
    <PackageReference Include="Microsoft.NET.Test.Sdk" />
    <PackageReference Include="xunit" />
    <PackageReference Include="xunit.runner.visualstudio" />
  </ItemGroup>

  <ItemGroup>
    <Using Include="Xunit" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\..\src\Hosts\Sergin.MeterMinder.Hosts.WebUi.All\Sergin.MeterMinder.Hosts.WebUi.All.csproj" />
    <ProjectReference Include="..\..\src\SharedKernel\Sergin.SharedKernel.IntegrationTests\Sergin.SharedKernel.IntegrationTests.csproj" />
  </ItemGroup>

  <ItemGroup>
    <!--
      GHSA-v5pm-xwqc-g5wc (CVE-2026-49451): stack overflow when PARSING untrusted OpenAPI
      documents in Microsoft.OpenApi. The host under test here (Sergin.MeterMinder.Hosts.WebUi.All)
      does not reference OpenAPI at all — the vulnerable 2.x package reaches this project solely through
      Sergin.SharedKernel.IntegrationTests -> Microsoft.AspNetCore.Mvc.Testing -> Microsoft.AspNetCore.OpenApi,
      and this test project never parses external OpenAPI documents. See the matching suppression in
      Sergin.SharedKernel.IntegrationTests.csproj.
    -->
    <NuGetAuditSuppress Include="https://github.com/advisories/GHSA-v5pm-xwqc-g5wc" />
  </ItemGroup>

</Project>
