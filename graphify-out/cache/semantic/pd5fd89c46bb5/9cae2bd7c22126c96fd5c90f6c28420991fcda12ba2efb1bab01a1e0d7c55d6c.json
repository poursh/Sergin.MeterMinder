{"nodes": [{"id": "_claude_skills_add_feature_skill_add_feature", "label": "add-feature Skill", "file_type": "document", "source_file": ".claude/skills/add-feature/SKILL.md", "source_location": "frontmatter", "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Scaffolds one CQRS vertical slice given <ModuleName> <AggregateFolder> <FeatureName> <command|query>. The repo has no scaffolding CLI, so slices are hand-authored against src/Modules/UserAccess/**/Users/** as the reference implementation \u2014 read the matching file before writing the new one instead of guessing the module, aggregate, or verb."}, {"id": "_claude_skills_add_feature_skill_vertical_slice_layout", "label": "CQRS Vertical Slice Layout", "file_type": "concept", "source_file": ".claude/skills/add-feature/SKILL.md", "source_location": "## Layout to create", "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Command: Command record + CommandResponse + internal sealed handler injecting the unit of work and repository, an optional new domain factory/behavior method, an IEndpoint implementation, and registration in <Aggregate>InstallationExtensions. Query: identical shape still under Commands/, implementing IQuery/IQueryHandler against a dedicated query repository using IDbConnectionFactory and raw SQL \u2014 never EF Core for reads."}, {"id": "_claude_skills_add_feature_skill_blazor_ui_slice", "label": "Optional Blazor UI Slice", "file_type": "concept", "source_file": ".claude/skills/add-feature/SKILL.md", "source_location": "## Optional: the UI slice", "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Three pages per aggregate (List, Detail, Create) plus a form model, each a .razor/.razor.cs pair. Entirely optional \u2014 plenty of slices are API-only and the module's Presentation.Blazor project may not exist, since pages consume the same MediatR handlers and nothing in Application/Infrastructure changes. Pages need no DI registration; only a nav item and an _Imports.razor using are added."}, {"id": "_claude_skills_add_feature_skill_endpoint_still_required", "label": "Always Ship the Endpoint", "file_type": "rationale", "source_file": ".claude/skills/add-feature/SKILL.md", "source_location": "## After scaffolding (closing note)", "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Write the endpoint even though no API host runs it: a slice shipping a page but no endpoint quietly breaks the property that an API host can be re-added as a ~20-line Program.cs. Its cost is one small file; skipping it costs the whole property."}], "edges": [{"source": "_claude_skills_add_feature_skill_add_feature", "target": "_claude_skills_add_feature_skill_vertical_slice_layout", "relation": "references", "confidence": "EXTRACTED", "confidence_score": 1.0, "source_file": ".claude/skills/add-feature/SKILL.md", "source_location": "## Layout to create", "weight": 1.0}, {"source": "_claude_skills_add_feature_skill_add_feature", "target": "_claude_skills_add_feature_skill_blazor_ui_slice", "relation": "references", "confidence": "EXTRACTED", "confidence_score": 1.0, "source_file": ".claude/skills/add-feature/SKILL.md", "source_location": "## Optional: the UI slice", "weight": 1.0}, {"source": "_claude_skills_add_feature_skill_vertical_slice_layout", "target": "_claude_claude_cqrs_split", "relation": "references", "confidence": "EXTRACTED", "confidence_score": 1.0, "source_file": ".claude/skills/add-feature/SKILL.md", "source_location": "## Layout to create", "weight": 1.0}, {"source": "_claude_skills_add_feature_skill_vertical_slice_layout", "target": "_claude_claude_idbconnectionfactory", "relation": "references", "confidence": "EXTRACTED", "confidence_score": 1.0, "source_file": ".claude/skills/add-feature/SKILL.md", "source_location": "Query (read-side, bypasses EF)", "weight": 1.0}, {"source": "_claude_skills_add_feature_skill_vertical_slice_layout", "target": "_claude_claude_requiredpermissions", "relation": "references", "confidence": "EXTRACTED", "confidence_score": 1.0, "source_file": ".claude/skills/add-feature/SKILL.md", "source_location": "If the query needs authorization, add [RequiredPermissions]", "weight": 1.0}, {"source": "_claude_skills_add_feature_skill_blazor_ui_slice", "target": "_claude_claude_iserginuidispatcher", "relation": "references", "confidence": "EXTRACTED", "confidence_score": 1.0, "source_file": ".claude/skills/add-feature/SKILL.md", "source_location": "Inject ISerginUiDispatcher, never ISender/IMediator", "weight": 1.0}, {"source": "_claude_skills_add_feature_skill_blazor_ui_slice", "target": "_claude_claude_iuierrorpresenter", "relation": "references", "confidence": "EXTRACTED", "confidence_score": 1.0, "source_file": ".claude/skills/add-feature/SKILL.md", "source_location": "Error handling, two shapes", "weight": 1.0}, {"source": "_claude_skills_add_feature_skill_blazor_ui_slice", "target": "_claude_claude_route_prefix_guard", "relation": "references", "confidence": "EXTRACTED", "confidence_score": 1.0, "source_file": ".claude/skills/add-feature/SKILL.md", "source_location": "Every @page template must start with /<schema>/", "weight": 1.0}, {"source": "_claude_skills_add_feature_skill_blazor_ui_slice", "target": "_claude_claude_razor_code_behind_rule", "relation": "references", "confidence": "EXTRACTED", "confidence_score": 1.0, "source_file": ".claude/skills/add-feature/SKILL.md", "source_location": ".razor holds markup only", "weight": 1.0}, {"source": "_claude_skills_add_feature_skill_blazor_ui_slice", "target": "_claude_claude_serginnavitem", "relation": "references", "confidence": "EXTRACTED", "confidence_score": 1.0, "source_file": ".claude/skills/add-feature/SKILL.md", "source_location": "Registration \u2014 add a SerginNavItem", "weight": 1.0}, {"source": "_claude_skills_add_feature_skill_blazor_ui_slice", "target": "_claude_claude_no_sort_filter_