@inject IHostEnvironment HostEnvironment
@inject SerginDocumentCulture DocumentCulture

<!DOCTYPE html>
<html lang="@SerginDocumentCulture.Lang" dir="@DocumentCulture.Dir">

<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <base href="/" />
    <ResourcePreloader />
    <link rel="stylesheet" href="@Assets["_content/MudBlazor/MudBlazor.min.css"]" />
    @if (HostEnvironment.IsDevelopment())
    {
        @* Styles for the Development-only theme manager drawer (SerginMainLayout), plus the font
           families its typography picker offers — without them, picking one previews the wrong face. *@
        <link rel="stylesheet" href="@Assets["_content/MudBlazor.ThemeManager/MudBlazorThemeManager.css"]" />
        <link rel="stylesheet" href="https://fonts.googleapis.com/css2?family=Roboto:wght@@300;400;500;700&display=swap" />
        <link rel="stylesheet" href="https://fonts.googleapis.com/css2?family=Montserrat:wght@@400;500;600;700&display=swap" />
        <link rel="stylesheet" href="https://fonts.googleapis.com/css2?family=Ubuntu:wght@@300;400;500;700&display=swap" />
    }
    @if (DocumentCulture.Dir == "rtl")
    {
        @* The right-to-left face, self-hosted (wwwroot/fonts/vazirmatn, OFL), applied by the [dir=rtl] rule in app.css. *@
        <link rel="stylesheet" href="@Assets["fonts/vazirmatn/vazirmatn.css"]" />
    }
    <link rel="stylesheet" href="@Assets["app.css"]" />
    @* No scoped-CSS bundle link: no component in the host or its RCLs has a .razor.css, so the bundle is not built.
       Add the link back (Sergin.MeterMinder.Hosts.All.styles.css) with the first one. *@
    <ImportMap />
    <HeadOutlet @rendermode="InteractiveServer" />
</head>

<body>
    <Routes @rendermode="InteractiveServer" />
    <script src="@Assets["_framework/blazor.web.js"]"></script>
    <script src="@Assets["_content/MudBlazor/MudBlazor.min.js"]"></script>
</body>

</html>
