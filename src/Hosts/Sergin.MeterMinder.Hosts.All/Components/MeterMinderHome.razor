@* This host's home slot, registered in Program.cs through AddSerginBlazorApp's configureHome. It replaces
   SharedKernel's SerginWelcome, which stays deliberately app-agnostic.

   No @page directive — the "/" route belongs to SharedKernel's SerginHomePage, which renders this
   through DynamicComponent. A second "/" template would make the routes ambiguous. *@

@inject IOptions<SerginApplicationOptions> ApplicationOptions
@inject IStringLocalizer Localizer

<MudText Typo="Typo.h4" HtmlTag="h1" GutterBottom="true">@ApplicationOptions.Value.ApplicationName</MudText>

<MudText Typo="Typo.body1" GutterBottom="true">@Localizer.Text(MeterMinderTexts.Description)</MudText>

<MudText Typo="Typo.body1" Color="Color.Secondary">@Localizer.Text(ShellTexts.Welcome.Prompt)</MudText>
