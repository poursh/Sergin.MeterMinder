<SerginAggregateListView TitleText="DeviceTexts.Title" Trail="Trail" Actions="Actions">
    <HeaderActions>
        <SerginReloadButton OnReload="ReloadAsync" />
    </HeaderActions>
    <Overview>
        <SerginOverviewCards>
            @foreach ((TextDefinition label, string value, string sub) in OverviewCards)
            {
                <SerginOverviewCard LabelText="label" Value="@value" Caption="@sub" />
            }
        </SerginOverviewCards>
    </Overview>
    <OverviewSummary>
        <MudText Typo="Typo.body2"><b>@(Count(overview?.Devices))</b> @Localizer.Text(DeviceTexts.SummaryDevices)</MudText>
        <MudText Typo="Typo.body2"><b>@(Count(overview?.ModelsInUse))</b> @Localizer.Text(DeviceTexts.SummaryModelsInUse)</MudText>
    </OverviewSummary>
    <ChildContent>
        <SerginAggregateList @ref="list" TItem="GetDeviceListItem" Load="LoadAsync"
                             SearchPlaceholderText="DeviceTexts.SearchPlaceholder"
                             BuildFilters="BuildFilters" OnFilterRemoved="OnFilterRemoved" OnFiltersReset="ResetFilterFields"
                             OnFilterPanelOpened="LoadFilterOptionsAsync" BulkActions="BulkActions">
            <HeaderContent>
                <MudTh><MudTableSortLabel T="GetDeviceListItem" SortLabel="@DeviceListFields.DeviceId">@Localizer.Text(DeviceTexts.DeviceId.Label)</MudTableSortLabel></MudTh>
                <MudTh><MudTableSortLabel T="GetDeviceListItem" SortLabel="@DeviceListFields.DeviceModelName">@Localizer.Text(DeviceTexts.DeviceModelName.Label)</MudTableSortLabel></MudTh>
                <MudTh><MudTableSortLabel T="GetDeviceListItem" SortLabel="@DeviceListFields.ManufacturerName">@Localizer.Text(DeviceTexts.ManufacturerName.Label)</MudTableSortLabel></MudTh>
            </HeaderContent>
            <RowTemplate>
                <MudTd DataLabel="@Localizer.Text(DeviceTexts.DeviceId.Label)"><MudLink Href="@($"/dm/devices/{context.Id}")">@context.DeviceId</MudLink></MudTd>
                <MudTd DataLabel="@Localizer.Text(DeviceTexts.DeviceModelName.Label)">@context.DeviceModelName</MudTd>
                <MudTd DataLabel="@Localizer.Text(DeviceTexts.ManufacturerName.Label)">@context.ManufacturerName</MudTd>
            </RowTemplate>
            <RowCommands>
                <MudTooltip Text="@Localizer.Text(CommonTexts.Edit)">
                    <MudIconButton Icon="@Icons.Material.Outlined.Edit" Size="Size.Small" Href="@($"/dm/devices/{context.Id}/edit")" aria-label="@Localizer.Text(CommonTexts.Edit)" />
                </MudTooltip>
                <MudTooltip Text="@Localizer.Text(CommonTexts.Delete)">
                    <MudIconButton Icon="@Icons.Material.Outlined.Delete" Size="Size.Small" OnClick="@(() => DeleteAsync(context))" aria-label="@Localizer.Text(CommonTexts.Delete)" />
                </MudTooltip>
            </RowCommands>
            <FilterPanel>
                <MudGrid Spacing="3">
                    <MudItem xs="12" sm="6" md="3">
                        <MudSelect T="Guid?" Label="@Localizer.Text(DeviceTexts.ManufacturerId.Label)" Value="filterManufacturerId" ValueChanged="OnFilterManufacturerChangedAsync"
                                   Clearable="true" Variant="Variant.Outlined" Margin="Margin.Dense">
                            @foreach (GetManufacturerListItem manufacturer in manufacturers)
                            {
                                <MudSelectItem T="Guid?" Value="@manufacturer.Id">@manufacturer.Name</MudSelectItem>
                            }
                        </MudSelect>
                    </MudItem>
                    <MudItem xs="12" sm="6" md="3">
                        <MudSelect T="Guid?" Label="@Localizer.Text(DeviceTexts.DeviceModelId.Label)" @bind-Value="filterModelId" Disabled="@(filterManufacturerId is null)"
                                   Clearable="true" Variant="Variant.Outlined" Margin="Margin.Dense">
                            @foreach (GetDeviceModelListItem model in models)
                            {
                                <MudSelectItem T="Guid?" Value="@model.Id">@model.Name</MudSelectItem>
                            }
                        </MudSelect>
                    </MudItem>
                    <MudItem xs="12" sm="6" md="3">
                        <MudSelect T="Guid?" Label="@Localizer.Text(DeviceTexts.ScopeId.Label)" @bind-Value="filterScopeId" Clearable="true"
                                   Variant="Variant.Outlined" Margin="Margin.Dense">
                            @foreach (ScopeOption scope in scopes)
                            {
                                <MudSelectItem T="Guid?" Value="@scope.Id">@(new string('·', Math.Max(0, scope.Depth - 1)) + " " + scope.Name)</MudSelectItem>
                            }
                        </MudSelect>
                    </MudItem>
                    <MudItem xs="12" sm="6" md="3">
                        <MudDateRangePicker Label="@Localizer.Text(DeviceTexts.CreatedBetween)" Culture="@Formatter.Culture" @bind-DateRange="filterCreated" Clearable="true"
                                            Variant="Variant.Outlined" Margin="Margin.Dense" />
                    </MudItem>
                </MudGrid>
            </FilterPanel>
        </SerginAggregateList>
    </ChildContent>
</SerginAggregateListView>
