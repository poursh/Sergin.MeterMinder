<SerginAggregateListView Title="Devices" Trail="Trail" Actions="Actions">
    <HeaderActions>
        <SerginReloadButton OnReload="ReloadAsync" />
    </HeaderActions>
    <Overview>
        <SerginOverviewCards>
            @foreach ((string label, string value, string sub) in OverviewCards)
            {
                <SerginOverviewCard Label="@label" Value="@value" Caption="@sub" />
            }
        </SerginOverviewCards>
    </Overview>
    <OverviewSummary>
        <MudText Typo="Typo.body2"><b>@(overview?.Devices.ToString(Culture) ?? "–")</b> devices</MudText>
        <MudText Typo="Typo.body2"><b>@(overview?.ModelsInUse.ToString(Culture) ?? "–")</b> models in use</MudText>
    </OverviewSummary>
    <ChildContent>
        <SerginAggregateList @ref="list" TItem="GetDeviceListItem" Load="LoadAsync"
                             SearchPlaceholder="Search device ID or model…"
                             BuildFilters="BuildFilters" OnFilterRemoved="OnFilterRemoved" OnFiltersReset="ResetFilterFields"
                             OnFilterPanelOpened="LoadFilterOptionsAsync" BulkActions="BulkActions">
            <HeaderContent>
                <MudTh><MudTableSortLabel T="GetDeviceListItem" SortLabel="@DeviceListFields.DeviceId">Device ID</MudTableSortLabel></MudTh>
                <MudTh><MudTableSortLabel T="GetDeviceListItem" SortLabel="@DeviceListFields.DeviceModelName">Model</MudTableSortLabel></MudTh>
                <MudTh><MudTableSortLabel T="GetDeviceListItem" SortLabel="@DeviceListFields.ManufacturerName">Manufacturer</MudTableSortLabel></MudTh>
            </HeaderContent>
            <RowTemplate>
                <MudTd DataLabel="Device ID"><MudLink Href="@($"/dm/devices/{context.Id}")">@context.DeviceId</MudLink></MudTd>
                <MudTd DataLabel="Model">@context.DeviceModelName</MudTd>
                <MudTd DataLabel="Manufacturer">@context.ManufacturerName</MudTd>
            </RowTemplate>
            <RowCommands>
                <MudTooltip Text="Edit">
                    <MudIconButton Icon="@Icons.Material.Outlined.Edit" Size="Size.Small" Href="@($"/dm/devices/{context.Id}/edit")" aria-label="Edit" />
                </MudTooltip>
                <MudTooltip Text="Delete">
                    <MudIconButton Icon="@Icons.Material.Outlined.Delete" Size="Size.Small" OnClick="@(() => DeleteAsync(context))" aria-label="Delete" />
                </MudTooltip>
            </RowCommands>
            <FilterPanel>
                <MudGrid Spacing="3">
                    <MudItem xs="12" sm="6" md="3">
                        <MudSelect T="Guid?" Label="Manufacturer" Value="filterManufacturerId" ValueChanged="OnFilterManufacturerChangedAsync"
                                   Clearable="true" Variant="Variant.Outlined" Margin="Margin.Dense">
                            @foreach (GetManufacturerListItem manufacturer in manufacturers)
                            {
                                <MudSelectItem T="Guid?" Value="@manufacturer.Id">@manufacturer.Name</MudSelectItem>
                            }
                        </MudSelect>
                    </MudItem>
                    <MudItem xs="12" sm="6" md="3">
                        <MudSelect T="Guid?" Label="Model" @bind-Value="filterModelId" Disabled="@(filterManufacturerId is null)"
                                   Clearable="true" Variant="Variant.Outlined" Margin="Margin.Dense">
                            @foreach (GetDeviceModelListItem model in models)
                            {
                                <MudSelectItem T="Guid?" Value="@model.Id">@model.Name</MudSelectItem>
                            }
                        </MudSelect>
                    </MudItem>
                    <MudItem xs="12" sm="6" md="3">
                        <MudSelect T="Guid?" Label="Scope" @bind-Value="filterScopeId" Clearable="true"
                                   Variant="Variant.Outlined" Margin="Margin.Dense">
                            @foreach (ScopeOption scope in scopes)
                            {
                                <MudSelectItem T="Guid?" Value="@scope.Id">@(new string('·', Math.Max(0, scope.Depth - 1)) + " " + scope.Name)</MudSelectItem>
                            }
                        </MudSelect>
                    </MudItem>
                    <MudItem xs="12" sm="6" md="3">
                        <MudDateRangePicker Label="Created between" @bind-DateRange="filterCreated" Clearable="true"
                                            Variant="Variant.Outlined" Margin="Margin.Dense" />
                    </MudItem>
                </MudGrid>
            </FilterPanel>
        </SerginAggregateList>
    </ChildContent>
</SerginAggregateListView>
