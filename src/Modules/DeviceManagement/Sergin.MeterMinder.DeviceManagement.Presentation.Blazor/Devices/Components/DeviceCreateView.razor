<SerginFormView TitleText="DeviceUiTexts.New" Trail="Trail"
                Model="model" Validation="validation" OnSubmit="OnSubmit" Submitting="submitting" SubmitLabelText="CommonTexts.Create" CancelHref="/dm/devices">
    <MudTextField Variant="Variant.Outlined" Margin="Margin.Dense" @bind-Value="model.DeviceId" Label="@Localizer.Text(DeviceTexts.DeviceId.Label)" For="@(() => model.DeviceId)" Immediate="true" />

    @* View state, not on the command: For= only gives the form-level validation a member path, which finds no rule. *@
    <MudSelect Variant="Variant.Outlined" Margin="Margin.Dense" T="Guid" Value="selectedManufacturerId" ValueChanged="OnManufacturerChangedAsync" Label="@Localizer.Text(DeviceTexts.ManufacturerId.Label)" Placeholder="@ManufacturerPlaceholder"
               For="@(() => selectedManufacturerId)">
        @foreach (GetManufacturerListItem manufacturer in manufacturers)
        {
            <MudSelectItem T="Guid" Value="@manufacturer.Id">@manufacturer.Name</MudSelectItem>
        }
    </MudSelect>

    <MudSelect Variant="Variant.Outlined" Margin="Margin.Dense" T="Guid" @bind-Value="model.DeviceModelId" Label="@Localizer.Text(DeviceTexts.DeviceModelId.Label)"
               Placeholder="@ModelPlaceholder"
               For="@(() => model.DeviceModelId)" Disabled="@(selectedManufacturerId == Guid.Empty)">
        @foreach (GetDeviceModelListItem deviceModel in deviceModels)
        {
            <MudSelectItem T="Guid" Value="@deviceModel.Id">@deviceModel.Name</MudSelectItem>
        }
    </MudSelect>
</SerginFormView>
