<SerginAggregateDetailView TitleText="DeviceTexts.Singular" Trail="Trail" Problem="problem" Ready="@(device is not null)" Actions="Actions"
                           FieldsTitle="@device?.DeviceId">
    <HeaderActions>
        <SerginReloadButton OnReload="LoadAsync" />
        <SerginCopyLinkButton />
        @if (device is not null)
        {
            <SerginInfoButton Load="LoadAuditAsync" Version="version" />
        }
    </HeaderActions>
    <Fields>
        @if (device is not null)
        {
            <SerginDetailField LabelText="DeviceTexts.DeviceId.Label" Value="@device.DeviceId" />
            <SerginDetailField LabelText="DeviceTexts.DeviceModelName.Label"><MudLink Href="@($"/dm/manufacturers/{device.ManufacturerId}/models/{device.DeviceModelId}")">@device.DeviceModelName</MudLink></SerginDetailField>
            <SerginDetailField LabelText="DeviceTexts.ManufacturerName.Label"><MudLink Href="@($"/dm/manufacturers/{device.ManufacturerId}")">@device.ManufacturerName</MudLink></SerginDetailField>
        }
    </Fields>
</SerginAggregateDetailView>
