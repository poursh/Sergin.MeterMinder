@page "/dm/devices/{Id:guid}"

<PageTitle>Device</PageTitle>

<MudButton StartIcon="@Icons.Material.Filled.ArrowBack" Href="/dm/devices" Class="mb-4">Back to devices</MudButton>

<SerginProblemPanel Problem="problem" />

@if (device is not null)
{
    <MudCard>
        <MudCardContent>
            <MudText Typo="Typo.h5">@device.DeviceId</MudText>
            @* Text, not a link: the model's page is nested under its manufacturer, and this read model
               deliberately carries no manufacturer id (spec, Decision 4). *@
            <MudText Typo="Typo.body2">Model: @device.DeviceModelName</MudText>
            <MudText Typo="Typo.body2">@device.Id</MudText>
        </MudCardContent>
    </MudCard>
}
