@page "/dm/devices/{Id:guid}"

<PageTitle>Device</PageTitle>

<SerginBreadcrumbs Trail="Trail" />

<SerginProblemPanel Problem="problem" />

@if (device is not null)
{
    <MudCard>
        <MudCardContent>
            <MudText Typo="Typo.h5">@device.DeviceId</MudText>
            <MudText Typo="Typo.body2">
                Model:
                <MudLink Href="@($"/dm/manufacturers/{device.ManufacturerId}/models/{device.DeviceModelId}")">@device.DeviceModelName</MudLink>
            </MudText>
            <MudText Typo="Typo.body2">@device.Id</MudText>
        </MudCardContent>
        <MudCardActions>
            <MudButton Variant="Variant.Outlined" Color="Color.Primary" Href="@($"/dm/devices/{Id}/edit")">Edit</MudButton>
            <MudButton Variant="Variant.Outlined" Color="Color.Error" Disabled="deleting" OnClick="DeleteAsync">Delete</MudButton>
        </MudCardActions>
    </MudCard>
}
