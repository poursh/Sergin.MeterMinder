@page "/dm/devices/new"

<PageTitle>New device</PageTitle>

<SerginBreadcrumbs Trail="Trail" />

<MudText Typo="Typo.h5" Class="mb-4">New device</MudText>

<MudForm @ref="form" Model="model" Validation="@validation" @bind-IsValid="isValid"
         SuppressImplicitSubmission="false" onsubmit="@OnSubmit">
    <MudCard>
        <MudCardContent>
            <MudTextField Variant="Variant.Outlined" Margin="Margin.Dense" @bind-Value="model.DeviceId" Label="Device ID" For="@(() => model.DeviceId)" Immediate="true" />

            @* Page state, not on the command: For= only gives the form-level validation a member path, which finds no rule. *@
            <MudSelect Variant="Variant.Outlined" Margin="Margin.Dense" T="Guid" Value="selectedManufacturerId" ValueChanged="OnManufacturerChangedAsync" Label="Manufacturer" Placeholder="Select a manufacturer"
                       For="@(() => selectedManufacturerId)">
                @foreach (GetManufacturerListItem manufacturer in manufacturers)
                {
                    <MudSelectItem T="Guid" Value="@manufacturer.Id">@manufacturer.Name</MudSelectItem>
                }
            </MudSelect>

            <MudSelect Variant="Variant.Outlined" Margin="Margin.Dense" T="Guid" @bind-Value="model.DeviceModelId" Label="Model"
                       Placeholder="@(selectedManufacturerId == Guid.Empty ? "Select a manufacturer first" : "Select a model")"
                       For="@(() => model.DeviceModelId)" Disabled="@(selectedManufacturerId == Guid.Empty)">
                @foreach (GetDeviceModelListItem deviceModel in deviceModels)
                {
                    <MudSelectItem T="Guid" Value="@deviceModel.Id">@deviceModel.Name</MudSelectItem>
                }
            </MudSelect>
        </MudCardContent>
        <MudCardActions>
            <MudButton ButtonType="ButtonType.Submit" Variant="Variant.Filled"
                       Color="Color.Primary" Disabled="@(submitting || !isValid)">Create</MudButton>
            <MudButton Href="/dm/devices">Cancel</MudButton>
        </MudCardActions>
    </MudCard>
</MudForm>
