@page "/dm/manufacturers/{Id:guid}"

<PageTitle>Manufacturer</PageTitle>

<SerginBreadcrumbs Trail="Trail" />

<SerginProblemPanel Problem="problem" />

@if (manufacturer is not null)
{
    <MudCard>
        <MudCardContent>
            <MudText Typo="Typo.h5">@manufacturer.Name</MudText>
            @if (manufacturer.Address is not null)
            {
                <MudText Typo="Typo.body2">Address: @manufacturer.Address</MudText>
            }
            <MudText Typo="Typo.body2">@manufacturer.Id</MudText>
        </MudCardContent>
        <MudCardActions>
            <MudButton Variant="Variant.Outlined" Color="Color.Primary" Href="@($"/dm/manufacturers/{Id}/edit")">Edit</MudButton>
            <MudButton Variant="Variant.Outlined" Color="Color.Error" Disabled="deleting" OnClick="DeleteAsync">Delete</MudButton>
        </MudCardActions>
    </MudCard>

    <DeviceModelTable ManufacturerId="Id" />
}
