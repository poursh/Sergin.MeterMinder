@page "/dm/manufacturers"

<PageTitle>Manufacturers</PageTitle>

<SerginBreadcrumbs Trail="Trail" />

<MudStack Row="true" Justify="Justify.SpaceBetween" AlignItems="AlignItems.Center" Class="mb-4">
    <MudText Typo="Typo.h4">Manufacturers</MudText>
    <MudButton Variant="Variant.Filled" Color="Color.Primary"
               StartIcon="@Icons.Material.Filled.Add" Href="/dm/manufacturers/new">New manufacturer</MudButton>
</MudStack>

<MudTable T="GetManufacturerListItem" ServerData="LoadAsync" Hover="true" Striped="true"
          OnRowClick="@(args => OpenManufacturer(args.Item))" RowsPerPage="10">
    <HeaderContent>
        <MudTh>Name</MudTh>
        <MudTh>Address</MudTh>
    </HeaderContent>
    <RowTemplate>
        <MudTd DataLabel="Name">@context.Name</MudTd>
        <MudTd DataLabel="Address">@context.Address</MudTd>
    </RowTemplate>
    <PagerContent>
        <MudTablePager />
    </PagerContent>
</MudTable>

<MudText Typo="Typo.caption">Server-side sorting and filtering are not implemented yet.</MudText>
