<SerginEntityDetailView TitleText="DeviceModelTexts.Singular" Trail="Trail" Problem="problem" Ready="@(deviceModel is not null)" Actions="Actions"
                        FieldsTitle="@deviceModel?.Name">
    <HeaderActions>
        <SerginCopyLinkButton />
    </HeaderActions>
    <Fields>
        @if (deviceModel is not null)
        {
            <SerginDetailField LabelText="DeviceModelTexts.Name.Label" Value="@deviceModel.Name" />
            <SerginDetailField LabelText="DeviceModelTexts.ManufacturerName.Label"><MudLink Href="@($"/dm/manufacturers/{deviceModel.ManufacturerId}")">@deviceModel.ManufacturerName</MudLink></SerginDetailField>
            <SerginDetailField LabelText="DeviceModelTexts.Identifier" Value="@deviceModel.Id.ToString()" />
        }
    </Fields>
</SerginEntityDetailView>
