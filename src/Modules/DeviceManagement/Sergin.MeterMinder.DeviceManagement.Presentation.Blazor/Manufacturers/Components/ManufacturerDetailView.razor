<SerginAggregateDetailView TitleText="ManufacturerTexts.Singular" Trail="Trail" Problem="problem" Ready="@(manufacturer is not null)" Actions="Actions"
                           OverviewCollapsed="true" FieldsTitleData="@manufacturer?.Name">
    <HeaderActions>
        <SerginReloadButton OnReload="ReloadAsync" />
        <SerginCopyLinkButton />
        @if (manufacturer is not null)
        {
            <SerginInfoButton Load="LoadAuditAsync" Version="version" />
        }
    </HeaderActions>
    <Overview>
        <SerginOverviewCards>
            <SerginOverviewCard LabelText="ManufacturerTexts.OverviewModels" ValueData="@Count(overview?.Models)" CaptionData="@Localizer.Text(ManufacturerTexts.OverviewOfManufacturer)" />
            <SerginOverviewCard LabelText="ManufacturerTexts.OverviewDevices" ValueData="@Count(overview?.Devices)" CaptionData="@Localizer.Text(ManufacturerTexts.OverviewInEveryScope)" />
        </SerginOverviewCards>
    </Overview>
    <OverviewSummary>
        <MudText Typo="Typo.body2"><b>@(Count(overview?.Models))</b> @Localizer.Text(ManufacturerTexts.SummaryModels)</MudText>
        <MudText Typo="Typo.body2"><b>@(Count(overview?.Devices))</b> @Localizer.Text(ManufacturerTexts.SummaryDevices)</MudText>
    </OverviewSummary>
    <Fields>
        @if (manufacturer is not null)
        {
            <SerginDetailField LabelText="ManufacturerTexts.Name.Label" Value="@manufacturer.Name" />
            <SerginDetailField LabelText="ManufacturerTexts.Address.Label" Value="@manufacturer.Address" />
        }
    </Fields>
    <Entities>
        <DeviceModelListView @ref="modelList" ManufacturerId="Id" Version="version" OnChanged="OnModelsChangedAsync" />
    </Entities>
</SerginAggregateDetailView>
