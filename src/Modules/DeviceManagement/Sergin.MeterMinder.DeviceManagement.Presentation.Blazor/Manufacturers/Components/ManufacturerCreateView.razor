<SerginFormView TitleText="ManufacturerUiTexts.New" Trail="Trail"
                Model="model" Validation="validation" OnSubmit="OnSubmit" Submitting="submitting" SubmitLabelText="CommonTexts.Create" CancelHref="/dm/manufacturers">
    <MudTextField Variant="Variant.Outlined" Margin="Margin.Dense" @bind-Value="model.Name" Label="@Localizer.Text(ManufacturerTexts.Name.Label)" For="@(() => model.Name)" Immediate="true" />
    <MudTextField Variant="Variant.Outlined" Margin="Margin.Dense" @bind-Value="model.Address" Label="@Localizer.Text(ManufacturerTexts.Address.Label)" For="@(() => model.Address)" Immediate="true" />
</SerginFormView>
