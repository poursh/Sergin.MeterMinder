<SerginAggregateListView TitleText="ManufacturerTexts.Title" Trail="Trail" Actions="Actions">
    <HeaderActions>
        <SerginReloadButton OnReload="ReloadAsync" />
    </HeaderActions>
    <ChildContent>
        <SerginAggregateList @ref="list" TItem="GetManufacturerListItem" Load="LoadAsync" SearchPlaceholderText="ManufacturerTexts.SearchPlaceholder"
                             BulkActions="BulkActions">
            <HeaderContent>
                <MudTh><MudTableSortLabel T="GetManufacturerListItem" SortLabel="@ManufacturerListFields.Name">@Localizer.Text(ManufacturerTexts.Name.Label)</MudTableSortLabel></MudTh>
                <MudTh>@Localizer.Text(ManufacturerTexts.Address.Label)</MudTh>
            </HeaderContent>
            <RowTemplate>
                <MudTd DataLabel="@Localizer.Text(ManufacturerTexts.Name.Label)"><MudLink Href="@($"/dm/manufacturers/{context.Id}")">@context.Name</MudLink></MudTd>
                <MudTd DataLabel="@Localizer.Text(ManufacturerTexts.Address.Label)">@context.Address</MudTd>
            </RowTemplate>
            <RowCommands>
                <MudTooltip Text="@Localizer.Text(DeviceManagementTexts.Edit)">
                    <MudIconButton Icon="@Icons.Material.Outlined.Edit" Size="Size.Small" Href="@($"/dm/manufacturers/{context.Id}/edit")" aria-label="@Localizer.Text(DeviceManagementTexts.Edit)" />
                </MudTooltip>
                <MudTooltip Text="@Localizer.Text(CommonTexts.Delete)">
                    <MudIconButton Icon="@Icons.Material.Outlined.Delete" Size="Size.Small" OnClick="@(() => DeleteAsync(context))" aria-label="@Localizer.Text(CommonTexts.Delete)" />
                </MudTooltip>
            </RowCommands>
        </SerginAggregateList>
    </ChildContent>
</SerginAggregateListView>
